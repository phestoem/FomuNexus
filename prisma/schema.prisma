// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model FormBlueprint {
  id           String    @id @default(cuid())
  label        String
  targetSchema Json
  toneProfile  Json
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions FormSession[]

  @@index([archivedAt, updatedAt])
  @@index([label])
}

model FormSession {
  id           String        @id @default(cuid())
  blueprintId  String
  capturedData Json
  status       SessionStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  blueprint FormBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId])
}
